{
  "name": "gleam",
  "displayName": "Gleam",
  "description": "Support for the Gleam programming language",
  "version": "2.13.1",
  "publisher": "gleam",
  "repository": {
    "type": "git",
    "url": "https://github.com/gleam-lang/vscode-gleam"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "icon": "images/icon.png",
  "contributes": {
    "languages": [
      {
        "id": "gleam",
        "aliases": [
          "Gleam",
          "gleam"
        ],
        "extensions": [
          ".gleam"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/gleam-logo.png",
          "dark": "./images/gleam-logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "gleam",
        "scopeName": "source.gleam",
        "path": "./syntaxes/gleam.tmLanguage.json"
      },
      {
        "scopeName": "markdown.gleam.codeblock",
        "path": "./syntaxes/gleam.codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.gleam": "gleam"
        }
      }
    ],
    "snippets": [
      {
        "language": "gleam",
        "path": "./snippets.json"
      }
    ],
    "commands": [
      {
        "command": "gleam.restartServer",
        "title": "Restart Gleam Server",
        "category": "Gleam"
      }
    ],
    "configurationDefaults": {
      "[gleam]": {
        "editor.formatOnSave": true
      }
    },
    "configuration": {
      "title": "Gleam",
      "properties": {
        "gleam.path": {
          "type": "string",
          "default": null,
          "description": "A path to the gleam executable. By default, the extension looks for gleam in the PATH, but if set, will use the path specified instead. Relative paths are resolved against the workspace folder.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "compile": "webpack --mode development",
    "compile-watch": "webpack --mode development --watch",
    "test-compile": "tsc -p ./",
    "vscode:package": "vsce package",
    "format-check": "prettier ./**/*.ts --check",
    "format": "prettier ./**/*.ts --write --cache"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.13.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.0",
    "vscode-test": "^1.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}
